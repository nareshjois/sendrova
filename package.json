{
	"name": "sendrova",
	"version": "1.0.0",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"start": "turbo run start --filter=@sendrova/desktop",
		"dev": "turbo run dev --filter=@sendrova/desktop",
		"dev:hmr": "turbo run dev:hmr --filter=@sendrova/desktop",
		"build": "turbo run build --filter=@sendrova/desktop",
		"build:canary": "turbo run build:canary --filter=@sendrova/desktop",
		"build:stable": "turbo run build:stable --filter=@sendrova/desktop",
		"typecheck": "turbo run typecheck --filter=@sendrova/desktop",
		"test": "turbo run test --filter=@sendrova/desktop",
		"lint": "turbo run lint --filter=@sendrova/desktop",
		"lint:fix": "turbo run lint:fix --filter=@sendrova/desktop",
		"icons": "bun run scripts/generate-icons.ts"
	},
	"devDependencies": {
		"turbo": "^2.5.4"
	},
	"packageManager": "bun@1.2.19"
}
