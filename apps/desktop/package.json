{
	"name": "@sendrova/desktop",
	"version": "1.1.4",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare:electrobun": "electrobun prepare",
		"start": "bun run prepare:electrobun && vite build && electrobun dev",
		"dev": "bun run prepare:electrobun && vite build && electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start:hmr\"",
		"start:hmr": "bun run prepare:electrobun && vite build && SENDROVA_HMR=1 electrobun dev",
		"hmr": "vite --port 5173",
		"build": "bun run prepare:electrobun && vite build",
		"build:canary": "bun run prepare:electrobun && vite build && electrobun build --env=canary",
		"build:stable": "bun run prepare:electrobun && vite build && electrobun build --env=stable",
		"typecheck": "bun run prepare:electrobun && tsc --noEmit",
		"test": "bun test src/bun",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@hapi/boom": "^10.0.1",
		"@sendrova/shared": "workspace:*",
		"@whiskeysockets/baileys": "7.0.0-rc14",
		"electrobun": "^2.0.1",
		"jimp": "^1.6.1",
		"lucide-react": "^1.35.0",
		"pino": "^10.3.1",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/bun": "^1.3.5",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.1"
	}
}
